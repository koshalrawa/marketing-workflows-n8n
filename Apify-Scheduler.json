      "parameters": {
        "jsCode": "const combinedContent = $input.all()\n  .map(item => {\n    const data = item.json;\n\n    const textContent = (\n      data.description ||\n      data.snippet ||\n      data.title ||\n      data.searchQuery?.term ||\n      'No content available'\n    ).slice(0, 1000); // shorter = faster + safer\n\n    return `Title: ${data.title || 'No title'}\nSource: ${data.source || 'Unknown'}\nURL: ${data.url || ''}\n\nContent:\n${textContent}`;\n  })\n  .join('\\n\\n----------------------\\n\\n');\n\nreturn [\n  {\n    json: {\n      content: combinedContent\n    }\n  }\n];"
      },
